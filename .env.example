SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Moment View"
CONTACT_TO_EMAIL=sales@momentview.site
# Comma-separated origins allowed to call /api/contact (scheme + host, no trailing slash).
CONTACT_ALLOWED_ORIGINS=https://momentview.site,https://www.momentview.site

# Optional: comma-separated trusted reverse-proxy IPs/subnets (or loopback, linklocal, uniquelocal).
# Used to read the visitor's address from X-Forwarded-For for rate limiting. See README.md.
TRUST_PROXY=
